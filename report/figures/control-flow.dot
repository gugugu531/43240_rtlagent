// 生成：dot -Tsvg dev/docs/report/figures/control-flow.dot -o dev/docs/report/figures/control-flow.svg
digraph control_flow {
  graph [rankdir=TB, bgcolor="transparent", pad="0.12", nodesep="0.48", ranksep="0.55", fontname="Noto Sans CJK SC"];
  node [shape=box, style="rounded,filled", fillcolor="#f4f6f8", color="#586779", fontname="Noto Sans CJK SC", fontsize=14, margin="0.18,0.14"];
  edge [color="#586779", arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=12];
  plan [label="题面与规划", fillcolor="#e8eff6"];
  generate [label="生成 RTL", fillcolor="#e8eff6"];
  check [label="结构检查\n按需行为检查"];
  finish [label="收尾与交付", fillcolor="#edf2ec"];
  feedback [label="分析与修复\nRTL 或检查器", fillcolor="#e8eff6"];
  {rank=same; plan; generate; check; finish;}
  plan -> generate -> check;
  check -> finish [label="检查结束"];
  check:sw -> feedback:nw [label="发现问题"];
  feedback:ne -> check:se [label="重新检查"];
}
