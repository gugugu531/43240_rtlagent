# cp remote.env.example remote.env，再按自己的服务器修改。remote.env 不会提交到 git。
#
# 运行方式：远端服务器只运行 vLLM（使用 GPU）；智能体、serve_api、Vivado 判定都在本机。
#
#   本机 127.0.0.1:$LOCAL_VLLM_PORT ══ SSH 隧道 ══> 远端 127.0.0.1:$REMOTE_VLLM_PORT (vLLM)
#
# 远端 vLLM 只监听 127.0.0.1，不开放公网端口，也不设置 API key。baseline.py 发请求时
# 不带 Authorization 请求头，所以只能通过隧道连接，不能给 vLLM 加 --api-key。

# ------------------------------------------------------------------- SSH

# user@host，或 ~/.ssh/config 里的别名。
# 使用 AMD Radeon Cloud 实例时写 cloud：地址和端口每次启动都会变，由 cloud.py 自动填写
REMOTE_HOST=user@gpu-server
REMOTE_SSH_PORT=22
# 额外的 ssh 参数，例如 "-i ~/.ssh/id_ed25519 -J jump-host"
REMOTE_SSH_OPTS=""

# ------------------------------------------------------------------ vLLM

# 远端存放 vllm.sh 与日志的目录（remote_vllm.sh 会自动创建并同步 vllm.sh）
REMOTE_DIR='~/fpgachina2026-remote'
# 远端的模型权重路径，传给 serve/vllm.sh 的 MODEL
REMOTE_MODEL="${REMOTE_MODEL:-/models/Qwen3-8B}"
REMOTE_VLLM_PORT=8000
# 须与 model/MODEL.md、manifest.json 声明的上下文一致
REMOTE_MAX_LEN=32768
REMOTE_GPU_UTIL=0.90
# 启动 vLLM 前执行的命令，例如激活环境。留空则直接用远端默认的 python3
REMOTE_ACTIVATE=""
# 额外环境变量，例如 NVIDIA 卡用 "CUDA_VISIBLE_DEVICES=0"
REMOTE_EXTRA_ENV="${REMOTE_EXTRA_ENV:-}"

# ------------------------------------------------------------------- 本机

# 隧道在本机上使用的端口。不用 8000，避免和本机自己启动的服务冲突
LOCAL_VLLM_PORT=18000
# submit_client / serve_local 使用的投题接口端口和令牌（仅用于本机测试，不是赛事方发的令牌）
LOCAL_API_PORT=7860
FPGACHINA_TOKEN=dev-local-token

# ------------------------------------------------------ AMD Radeon Cloud

# 只有 REMOTE_HOST=cloud 时才用到，见 README「使用 AMD Radeon Cloud 实例」。
# Platform API 地址。中国站点是 https://developer.amd.com.cn/radeon（文档没有写，
# 是从控制台网页找到的）；Global 站点是 https://radeon-global.anruicloud.com。
# 两个站点的账号、key、credits 不通用
RC_API_BASE=https://developer.amd.com.cn/radeon
# 中国站点的平台接口只认浏览器的登录状态，不接受 API key。登录控制台后，在浏览器
# 开发者工具的 Network 面板里任选一个 /radeon/api/ 开头的请求，复制请求头 Cookie 的
# 完整值填在这里（不要加引号）。登录过期后需要重新复制。和密码一样保管，不要提交
RC_COOKIE=
# API key，rc- 开头，控制台 Profile 页面可见。Global 站点的平台接口用它；中国站点
# 的平台接口不接受，只能用于模型接口
RC_API_KEY=
# 启动用的模板 id（./cloud.py templates 查看）。模板需要打开 SSH Access，
# 存储建议选 Persistent (PVC)，否则每次启动都要重新下载模型权重
RC_TEMPLATE_ID=
# GPU 数量，只能是 1、2、4。比赛限定单卡，填 1
RC_GPU_COUNT=1
# 看门狗时限（分钟）：实例启动后最多存在这么久，到时无论是否在用都会被销毁
RC_MAX_MINUTES=180
# 等待实例就绪的最长时间（秒）
RC_READY_TIMEOUT=1200
# 平台显示就绪后，实例里的 SSH 服务还要过一段时间才能登录，最多再等这么久（秒）
RC_SSH_TIMEOUT=600
