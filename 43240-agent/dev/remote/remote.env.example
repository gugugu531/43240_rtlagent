# cp remote.env.example remote.env，按自己的服务器改。remote.env 不进版本库。
#
# 拓扑：远端只跑 vLLM（GPU），智能体、serve_api、Vivado 判定都在本机。
#
#   本机 127.0.0.1:$LOCAL_VLLM_PORT ══ SSH 隧道 ══> 远端 127.0.0.1:$REMOTE_VLLM_PORT (vLLM)
#
# 远端 vLLM 只绑 127.0.0.1，不开公网端口、不需要 API key。baseline.py 不带
# Authorization 头，这也是只能走隧道、不能给 vLLM 加 --api-key 的原因。

# ------------------------------------------------------------------- SSH

# user@host，或 ~/.ssh/config 里的别名
REMOTE_HOST=user@gpu-server
REMOTE_SSH_PORT=22
# 额外的 ssh 参数，例如 "-i ~/.ssh/id_ed25519 -J jump-host"
REMOTE_SSH_OPTS=""

# ------------------------------------------------------------------ vLLM

# 远端存放 vllm.sh 与日志的目录（remote_vllm.sh 会自动创建并同步 vllm.sh）
REMOTE_DIR='~/fpgachina2026-remote'
# 远端的模型权重路径，传给 serve/vllm.sh 的 MODEL
REMOTE_MODEL=/models/Qwen3-8B
REMOTE_VLLM_PORT=8000
# 须与 model/MODEL.md、manifest.json 声明的上下文一致
REMOTE_MAX_LEN=32768
REMOTE_GPU_UTIL=0.90
# 启动 vLLM 前执行的命令，例如激活环境。留空则直接用远端默认的 python3
REMOTE_ACTIVATE=""
# 额外环境变量，例如 NVIDIA 卡用 "CUDA_VISIBLE_DEVICES=0"
REMOTE_EXTRA_ENV=""

# ------------------------------------------------------------------- 本机

# 隧道在本机的落点。不用 8000，免得和本机自己起的服务冲突
LOCAL_VLLM_PORT=18000
# submit_client / serve_local 用的投题接口端口与令牌（本机自测用，非赛事方令牌）
LOCAL_API_PORT=7860
FPGACHINA_TOKEN=dev-local-token
